<?xml version="1.0" encoding="utf-8"?>
<Project>
<!-- This group sets version used packages in FastReport.Core, FastReport.OpenSource, FastReport .NET, FastReport.WPF -->
    <PropertyGroup>

        <!-- WPF -->
        <FRWPFVersion>2025.2.0</FRWPFVersion>

        <!-- Keep the managed API and native binaries on one deterministic version. -->
        <SkiaSharpVersion>4.151.1</SkiaSharpVersion>
        <HarfBuzzVersion>4.151.1</HarfBuzzVersion>

        <!-- Avalonia -->
        <AvaloniaUIVersion>[11.1.0,)</AvaloniaUIVersion>
        <FRAvaloniaVersion>2025.2.0</FRAvaloniaVersion>

        <CodeAnalysisCSharpVersion>[4.0.1,)</CodeAnalysisCSharpVersion>
        <CodeAnalysisVisualBasicVersion>[4.0.1,)</CodeAnalysisVisualBasicVersion>

        <SystemSecurityCryptographyPkcsVersion>4.7.0</SystemSecurityCryptographyPkcsVersion>

    </PropertyGroup>

<!-- This group sets version used packages in Demos -->
    <PropertyGroup>

        <FRCoreVersion>2025.2.0</FRCoreVersion>

        <FROSVersion>2025.2.0</FROSVersion>

    </PropertyGroup>

</Project>
