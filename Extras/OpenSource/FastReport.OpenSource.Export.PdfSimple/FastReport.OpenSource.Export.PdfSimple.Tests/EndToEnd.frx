<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp">
  <ScriptText>using System;
using System.Drawing;
using System.Windows.Forms;
using FastReport;

namespace FastReport
{
  public class ReportScript
  {
    private void Name_BeforePrint(object sender, EventArgs e)
    {
      Name.TextColor = Color.DarkGreen;
      Name.Padding = new System.Windows.Forms.Padding(3, 2, 3, 2);
    }
  }
}</ScriptText>
  <Dictionary>
    <Parameter Name="HeadingText" DataType="System.String"/>
    <TableDataSource Name="Employees" ReferenceName="Data.Employees" DataType="System.Int32" Enabled="true">
      <Column Name="ID" DataType="System.Int32"/>
      <Column Name="Name" DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1">
    <ReportTitleBand Name="Title" Width="718.2" Height="37.8">
      <TextObject Name="Heading" Width="718.2" Height="28.35" Fill="LinearGradient" Fill.StartColor="LightSkyBlue" Fill.EndColor="AliceBlue" Fill.Angle="90" Text="[HeadingText]" HorzAlign="Center" VertAlign="Center" Font="Arial, 12pt, style=Bold"/>
    </ReportTitleBand>
    <DataBand Name="Rows" Top="41.8" Width="718.2" Height="18.9" DataSource="Employees">
      <TextObject Name="Id" Width="94.5" Height="18.9" Text="[Employees.ID]"/>
      <TextObject Name="Name" Left="103.95" Width="198.45" Height="18.9" BeforePrintEvent="Name_BeforePrint" Text="[Employees.Name]"/>
    </DataBand>
  </ReportPage>
</Report>
